{
  "name": "@getstation/sdk",
  "version": "0.16.0",
  "author": "joel@getstation.com",
  "license": "ISC",
  "description": "Station SDK",
  "main": "./lib/index",
  "types": "./lib/index",
  "bugs": {
    "url": "https://github.com/getstation/sdk/issues"
  },
  "homepage": "https://github.com/getstation/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getstation/sdk.git"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rimraf lib",
    "release": "yarn build",
    "dev": "yarn build",
    "lint": "tslint -p .",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^24.9.1",
    "@types/react": "^16.14.40",
    "@types/react-dom": "^16.9.18",
    "jest": "^26.6.3",
    "rimraf": "^5.0.10",
    "rxjs": "^6.6.7",
    "tslint": "^5.12.1",
    "tslint-config-station": "^0.6.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2016",
            "parser": {
              "syntax": "typescript",
              "tsx": true,
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true,
              "useDefineForClassFields": false,
              "react": {
                "runtime": "classic"
              }
            }
          },
          "module": {
            "type": "commonjs",
            "noInterop": true
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "jsx"
    ]
  }
}
