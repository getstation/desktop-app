{
  "name": "@getstation/theme",
  "version": "1.3.0",
  "description": "Station Theme & Styleguide",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rimraf ./dist && tsc",
    "clean": "rimraf dist",
    "release": "yarn build",
    "dev": "yarn build",
    "typedoc": "rimraf ./docs/typedoc && typedoc --out ./docs/typedoc ./lib",
    "prepublishOnly": "rimraf ./dist && tsc",
    "storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider start-storybook -s ./ -p 6006",
    "build-storybook": "rimraf ./docs/storybook && cross-env NODE_OPTIONS=--openssl-legacy-provider build-storybook",
    "build-docs": "yarn run build-storybook && yarn run typedoc",
    "lint": "tslint -p .",
    "lint:ci": "tslint -p . -c tslint-ci.json",
    "generate:icons": "ts-node --transpile-only scripts/generate-icons.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "classnames": "^2.2.6",
    "color": "^3.0.0",
    "create-react-context": "^0.2.2",
    "jss-nested": "^6.0.1",
    "linked-map": "^2.2.2",
    "mousetrap": "^1.6.5",
    "ms": "^2.1.1",
    "react": "^16.14.0",
    "react-debounce-input": "^3.2.0",
    "react-dom": "^16.14.0",
    "react-hover-observer": "^2.1.0",
    "react-jss": "^8.6.1",
    "react-key-handler": "1.0.1",
    "react-popper": "^1.3.4",
    "react-select": "^3.0.4",
    "shortid": "^2.2.8"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^5.2.5",
    "@storybook/addon-backgrounds": "^5.2.5",
    "@storybook/addon-centered": "^5.2.5",
    "@storybook/addon-info": "^5.2.5",
    "@storybook/addon-knobs": "^5.2.5",
    "@storybook/addon-links": "^5.2.5",
    "@storybook/addon-notes": "^5.2.5",
    "@storybook/addon-options": "^5.2.5",
    "@storybook/addon-storysource": "^5.2.5",
    "@storybook/addon-viewport": "^5.2.5",
    "@storybook/addons": "^5.2.5",
    "@storybook/react": "^5.2.5",
    "@svgr/core": "^4.3.3",
    "@svgr/plugin-prettier": "^4.3.2",
    "@types/classnames": "^2.2.6",
    "@types/color": "^3.0.0",
    "@types/glob": "^7.1.1",
    "@types/mousetrap": "^1.6.0",
    "@types/ms": "^0.7.30",
    "@types/react": "^16.14.40",
    "@types/react-dom": "^16.9.18",
    "@types/react-jss": "^8.6.3",
    "@types/react-select": "^3.0.4",
    "@types/shortid": "^0.0.29",
    "@types/storybook__addon-actions": "^3.4.0",
    "@types/storybook__addon-centered": "^3.3.0",
    "@types/storybook__addon-info": "^3.4.0",
    "@types/storybook__addon-knobs": "^3.3.1",
    "@types/storybook__addon-notes": "^3.3.2",
    "@types/storybook__react": "^3.0.8",
    "babel-core": "^6.26.3",
    "babel-runtime": "^6.26.0",
    "change-case": "^4.1.0",
    "cross-env": "^6.0.3",
    "glob": "^7.1.6",
    "popper.js": "^1.14.4",
    "rimraf": "^2.6.2",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.5.4",
